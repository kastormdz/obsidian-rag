# Runs the reindex service every 2 minutes and shortly after boot.
# `obsn reindex` is incremental (content hash) and a no-op build takes ~0.1 s, so this is
# cheap; it exists for edits that did not go through `obsn`.
[Unit]
Description=Run obsn reindex every 2 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=2min
AccuracySec=30s
Unit=obsn-reindex.service

[Install]
WantedBy=timers.target
